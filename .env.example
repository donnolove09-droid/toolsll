# Số lượng tài khoản cần tạo
ACCOUNT_COUNT=100

# Số luồng chạy song song (khuyến nghị 3-5)
THREAD_COUNT=3

# Ngưỡng rarity (1-10, càng cao càng hiếm)
RARITY_THRESHOLD=8

# Region (chỉ hỗ trợ VN)
REGION=VN

# Tên cơ sở
BASE_NAME=WJXAZ

# Mật khẩu cơ sở
BASE_PASSWORD=TELE@WJXAZ

# Tự động chạy worker khi khởi động
AUTO_START=true

# Chỉ chạy 1 lần rồi thoát
RUN_ONCE=true

# Port cho health server
PORT=10000
